MYSQL_DATABASE=webcollector
MYSQL_USER=webcollector
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
REDIS_PASSWORD=replace-with-strong-redis-password
REGISTRATION_ENABLED=true
RATE_LIMIT_LOGIN_ENABLED=true
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_ENABLED=true
RATE_LIMIT_REGISTER_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=600
RATE_LIMIT_CREATE_LINK_ENABLED=true
RATE_LIMIT_CREATE_LINK_LIMIT=30
RATE_LIMIT_CREATE_LINK_WINDOW_SECONDS=60
RATE_LIMIT_TRUSTED_PROXY_CIDRS=172.16.0.0/12
CAPTURE_WORKER_ID=capture-worker-docker
WEB_PORT=8080
