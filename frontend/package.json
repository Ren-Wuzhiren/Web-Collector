{
  "name": "webcollector-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:failure": "npm run build && playwright test e2e/m7-failure.spec.js",
    "test:e2e:capture": "npm run build && playwright test e2e/m7-flow.spec.js",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "check:visual": "node scripts/m7-visual-check.mjs",
    "check:m7": "npm run test:e2e && npm run check:visual"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "axios": "^1.11.0",
    "element-plus": "^2.10.7",
    "motion-v": "^2.11.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.3"
  }
}
